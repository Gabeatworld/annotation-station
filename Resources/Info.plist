<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AnnotationStation</string>
    <key>CFBundleIdentifier</key>
    <string>com.gabe.annotation-station</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Annotation Station</string>
    <key>CFBundleDisplayName</key>
    <string>Annotation Station</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Annotation Station captures the display under your cursor so you can draw numbered marks on it and send them to a coding agent.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Annotation Station re-activates the app you were using and pastes the prompt into it, and asks your browser which page you annotated so website feedback can record it.</string>
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/Gabeatworld/annotation-station/main/appcast.xml</string>
    <!-- EdDSA public key that release builds must be signed with. Fill this in once, from the
         output of Scripts/release.sh --keys (which runs Sparkle's generate_keys). While it is
         empty the app disables updates entirely instead of trusting an unsigned feed. -->
    <key>SUPublicEDKey</key>
    <string></string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
